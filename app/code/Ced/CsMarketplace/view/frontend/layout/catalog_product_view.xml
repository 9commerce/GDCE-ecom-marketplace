<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Ced_CsMarketplace::css/vendorinformation.css" />
    </head>
    <body>
        <referenceContainer name="product.info.main">
            <block class="Ced\CsMarketplace\Block\Catalog\Product\View"
                name="product.view.extra"
                template="Ced_CsMarketplace::vendor.phtml" before="-">
                <arguments>
                    <argument name="vendorSetting" xsi:type="object">Ced\CsMarketplace\ViewModel\Product\Vendor</argument>
                </arguments>
            </block>
            <block class="Ced\CsMarketplace\Block\Catalog\Product\View"
                name="product.view.extra.vendordetail"
                template="Ced_CsMarketplace::vendordetails.phtml" before="product.view.extra">
            </block>
        </referenceContainer>
    </body>
</page>
