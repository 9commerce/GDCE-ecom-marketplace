<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Ced_CsMarketplace::bower_components/font-awesome/css/font-awesome.min.css"/>
        <css src="Ced_CsMarketplace::css/vendorlisting.css" />
        <css src="Ced_CsMarketplace::css/shoppage.css" />
    </head>
    <body>
        <referenceContainer name="page.top">
            <container name="page.vendor.container" htmlTag="div" htmlClass="vendorshop-wrapper">
                <container name="main.content.vendor.area" htmlTag="div" htmlClass="page-main">
                    <block class="Magento\Framework\View\Element\Template" name="country_filter"
                           as="country_filter"
                           template="Ced_CsMarketplace::vshops/country_filter.phtml" />
                    <block class="Ced\CsMarketplace\Block\Vshops\ListBlock" name="vendors.homepage.list"
                           template="Ced_CsMarketplace::vshops/list.phtml" cacheable="false"/>
                </container>
            </container>
        </referenceContainer>
        <move element="country_filter" destination="vendors.homepage.list" />
        <referenceContainer name="main" remove="true"/>
        <referenceBlock name="sale.reorder.sidebar" remove="true" />
        <referenceBlock name="wishlist_sidebar" remove="true"/>
        <referenceBlock name="catalog.compare.sidebar" remove="true"/>
        <referenceContainer name="sidebar.main" remove="true"/>

    </body>
</page>
