<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="msrp_popup"/>
    <head>
        <css src="Ced_CsMarketplace::bower_components/font-awesome/css/font-awesome.min.css"/>
        <css src="Ced_CsMarketplace::css/category.css"/>
        <css src="Ced_CsMarketplace::css/shoppage.css"/>
    </head>
    <body>
        <referenceContainer name="page.top">
            <container name="page.vendor.container" htmlTag="div" htmlClass="vendorshop-wrapper">
                <container name="main.content.vendor.area" htmlTag="div" htmlClass="page-main">
                    <container name="page.messages" htmlTag="div" htmlClass="page messages">
                        <block class="Magento\Framework\View\Element\Template" name="ajax.message.placeholder" template="Magento_Theme::html/messages.phtml"/>
                        <block class="Magento\Framework\View\Element\Messages" name="messages" as="messages" template="Magento_Theme::messages.phtml"/>
                    </container>
                    <container name="banner.wrapper" htmlTag="div" htmlClass="banner-wrapper">
                        <block class="Ced\CsMarketplace\Block\Vshops\View" name="csmarketplace_vshops_banner"
                               template="Ced_CsMarketplace::vshops/banner.phtml"/>

                        <block class="Ced\CsMarketplace\Block\Vshops\View" name="csmarketplace_vshops_view"
                               template="Ced_CsMarketplace::vshops/view.phtml"/>
                    </container>
                    <!--<block class="Ced\CsMarketplace\Block\Vshops\View" name="csmarketplace_vshops_banner"-->
                    <!--template="Ced_CsMarketplace::vshops/banner.phtml"/>-->
                    <!--<block class="Ced\CsMarketplace\Block\Vshops\View" name="csmarketplace_vshops_view" after="page.top"-->
                    <!--template="Ced_CsMarketplace::vshops/view.phtml"/>-->
                    <!--<block class="Ced\CsMarketplace\Block\Vshops\Left" name="csmarketplace.vshops.category.filter"-->
                    <!--template="vshops/left.phtml" after="csmarketplace_vshops_view"/>-->
                    <block class="Ced\CsMarketplace\Block\Vshops\View" name="csmarketplace_vshops_about"
                           template="Ced_CsMarketplace::vshops/about.phtml"
                           after="csmarketplace.vshops.category.filter"/>

                    <container name="search.toolbar" before="vendors.homepage.list" htmlTag="div"
                               htmlClass="search-toolbar quick">
                        <block class="Ced\CsMarketplace\Block\Vshops\View"
                               name="csmarketplace_vshops_search_products"
                               template="Ced_CsMarketplace::vshops/search.phtml"/>
                    </container>
                    <block class="Ced\CsMarketplace\Block\Vshops\Left" name="csmarketplace.vshops.category.filter"
                           template="vshops/left.phtml"/>
                    <container name="product.list" htmlTag="div" htmlClass="product-list">
                        <block class="Ced\CsMarketplace\Block\Vshops\Catalog\Product\ListProduct"
                               name="vendors.homepage.list"
                               template="Ced_CsMarketplace::vshops/product/list.phtml" after="csmarketplace_vshops_about">
                            <block class="Magento\Catalog\Block\Product\ProductList\Toolbar" name="product_list_toolbar"
                                   template="Ced_CsMarketplace::vshops/product/list/toolbar.phtml">
                                <block class="Magento\Theme\Block\Html\Pager" name="product_list_toolbar_pager"/>
                            </block>
                            <action method="setToolbarBlockName">
                                <argument name="name" xsi:type="string">product_list_toolbar</argument>
                            </action>
                        </block>
                    </container>
                </container>
            </container>
        </referenceContainer>
        <move element="page.main.title" destination="csmarketplace_vshops_view" />
        <move element="csmarketplace_vshops_about" destination="csmarketplace_vshops_view" />
        <referenceContainer name="sidebar.main" remove="true"/>
        <referenceBlock name="sale.reorder.sidebar" remove="true"/>
        <referenceBlock name="wishlist_sidebar" remove="true"/>
        <referenceBlock name="catalog.compare.sidebar" remove="true"/>

        <referenceBlock name="vendors.homepage.list">
            <arguments>
                <argument name="viewModel" xsi:type="object">Ced\CsMarketplace\ViewModel\Product\OptionsData</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
