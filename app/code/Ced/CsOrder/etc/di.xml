<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
	<preference for="Ced\CsMarketplace\Model\Vorders" type="Ced\CsOrder\Model\Vorders"/>


    <type name="Ced\CsMarketplace\Ui\Component\Listing\Columns\Vorders\View">
        <plugin name="csorder_view_path_Plugin" type="Ced\CsOrder\Ui\Component\Listing\Columns\Vorders\ViewPlugin"
                sortOrder="10" disabled="false" />
    </type>

    <type name="Ced\CsMarketplace\Model\Vendor">
        <plugin name="only_show_approved_orders" type="Ced\CsOrder\Plugin\ShowApprovedOrders"
                sortOrder="1" disabled="false" />
    </type>

    <type name="Ced\CsMarketplace\Helper\Report">
        <plugin name="only_show_approved_orders_products_sold" type="Ced\CsOrder\Plugin\ShowApprovedOrdersProducts"
                sortOrder="0" disabled="false" />
    </type>


    <type name="Ced\CsMarketplace\Block\Vendor\Dashboard\MostSoldProducts">
        <plugin name="only_show_approved_orders_best_selling_products_sold" type="Ced\CsOrder\Plugin\ShowBestSellingProducts"
                sortOrder="0" disabled="false" />
    </type>


</config>
