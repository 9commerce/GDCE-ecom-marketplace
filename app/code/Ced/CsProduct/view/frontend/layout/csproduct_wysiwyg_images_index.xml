<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/layout_generic.xsd">
    <container name="root">
        <block class="Ced\CsProduct\Block\Wysiwyg\Images\Content" name="wysiwyg_images.content"
               template="Ced_CsProduct::browser/content.phtml">
            <block class="Ced\CsProduct\Block\Wysiwyg\Images\Tree" name="wysiwyg_images.tree"
                   template="Ced_CsProduct::browser/tree.phtml"/>
            <block class="Ced\CsProduct\Block\Wysiwyg\Images\Content\Uploader" name="wysiwyg_images.uploader"
                   template="Ced_CsProduct::browser/content/uploader.phtml">
                <arguments>
                    <argument name="image_upload_config_data" xsi:type="object">Magento\Backend\Block\DataProviders\ImageUploadConfig</argument>
                </arguments>
            </block>
        </block>
    </container>
</layout>
