<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Ced_CsMarketplace::bower_components/font-awesome/css/font-awesome.min.css"/>
        <css src="Ced_CsMarketplace::css/shoppage.css"/>
    </head>
    <body>
        <referenceContainer name="page.top">
            <container name="page.vendor.container" htmlTag="div" htmlClass="vendorshop-wrapper">
                <container name="main.content.vendor.area" htmlTag="div" htmlClass="page-main">
                    <container name="page.messages" htmlTag="div" htmlClass="page messages">
                        <block class="Magento\Framework\View\Element\Template" name="ajax.message.placeholder" template="Magento_Theme::html/messages.phtml"/>
                        <block class="Magento\Framework\View\Element\Messages" name="messages" as="messages" template="Magento_Theme::messages.phtml"/>
                    </container>
                    <container name="banner.wrapper" htmlTag="div" htmlClass="banner-wrapper">
                        <block class="Ced\CsMarketplace\Block\Vshops\View" name="csmarketplace_vshops_banner"
                               template="Ced_CsMarketplace::vshops/banner.phtml"/>
                        <block class="Ced\CsMarketplace\Block\Vshops\View" name="csmarketplace_vshops_view"
                               before="catalog.leftnav" template="Ced_CsMarketplace::vshops/view.phtml">
                            <block class="Ced\CsMarketplace\Block\Vshops\View" name="csmarketplace_vshops_about"
                                   template="Ced_CsMarketplace::vshops/about.phtml"
                                   after="csmarketplace.vshops.category.filter"/>
                            <block class="Ced\CsVendorReview\Block\Vshops\View"
                            name="csmarketplace_vshops_view_rating" cacheable="false" template="Ced_CsVendorReview::vshops/ratings.phtml"/>
                        </block>
                        <block class="Ced\CsVendorReview\Block\Rating\Lists" name="csvendor_rating_submit"
                               template="Ced_CsVendorReview::vshops/submitrating.phtml">
                            <block class="Ced\CsVendorReview\Block\Rating\Form" name="csvendorreview_rating_form"
                                   as="csvendorreview_rating_form" template="Ced_CsVendorReview::rating/form.phtml"/>
                        </block>
                    </container>
                    <block class="Ced\CsVendorReview\Block\Rating\Lists" name="csvendorreview_rating_lists"
                           template="Ced_CsVendorReview::rating/lists.phtml" cacheable="false">
                        <block class="Magento\Theme\Block\Html\Pager" name="product_review_list.toolbar"/>
                    </block>
                </container>
            </container>
        </referenceContainer>
        <move element="page.main.title" destination="csmarketplace_vshops_view"/>
        <referenceBlock name="wishlist_sidebar" remove="true"/>
        <referenceBlock name="multiple-wishlist_sidebar" remove="true"/>
        <referenceBlock name="catalog.compare.sidebar" remove="true"/>
        <referenceBlock name="sale.reorder.sidebar" remove="true"/>
        <referenceContainer name="main" remove="true"/>
    </body>
</page>
