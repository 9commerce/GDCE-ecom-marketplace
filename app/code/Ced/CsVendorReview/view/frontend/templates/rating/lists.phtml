                                        <span style="width:
                                        <?= $dr["count"] ? $escaper->escapeHtml(ceil($dr["rating"]/$dr["count"])) : 0 ?>%">
                                            <span>

                                            </span>
                                        </span>
                                                            </div>
                                                        </div>
                                                    </li>
                                                <?php } ?>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <p class="review-date">
