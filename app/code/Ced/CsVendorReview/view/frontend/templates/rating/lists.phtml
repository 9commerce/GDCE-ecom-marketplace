                                            <image id="image0_130_227" width="24" height="24"
                                                   xlink:href="data:image/png;base64,"/>
                                        </defs>
                                    </svg>
                                    <div id="avg-rating" class="block-content vendor-rating">
                                        <div id="narrow-by-list2">
