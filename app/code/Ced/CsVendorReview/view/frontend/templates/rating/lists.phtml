<?php
/**
 * @var \Magento\Framework\Escaper $escaper
 */
$_items = $block->getReviews();
$format = $block->getDateFormat() ?: \IntlDateFormatter::SHORT;
$_votes = $block->getRatings();
$messages = $block->getMessages();
if ($msg = $messages->getLastAddedMessage()) { ?>
    <script>
        require(['mage/url','jquery'], function() {
            jQuery('.messages')
                .first()
                .after('<div class="message-success success message">' +
                    '<div><?= $escaper->escapeHtml($msg->getText())?></div></div>');
        });
    </script>
<?php } ?>
<div>
    <h3>Reviews (<?= count($_items)?> reviews)</h3>
</div>
<div class="block review-list" id="customer-reviews">
    <div class="block-title">
    </div>
    <div class="block-content">
        <ol class="items review-items">
            <?php foreach ($_items as $_review) { ?>
                <li class="item review-item" itemscope itemprop="review" itemtype="http://schema.org/Review">
                    <div class="review-items-wrapper">
                    <?php if (count($_votes)) { ?>
                    <div class="review-details">
                        <div class="review-ratings-wrap">
                            <p class="review-author">
                                <strong class="review-author-name" itemprop="author">
                                    <?= $escaper->escapeHtml($_review->getCustomerName()); ?>
                                </strong>
                            </p>
                            <div class="review-ratings-star">
                                <?php $avgRating = $block->getAvgRating($_review); ?>
                                <div class="block-title" id="avg-rating-container" title=''>
                                    <strong><span><?= $avgRating ?></span></strong>
                                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="13"
                                         height="12" viewBox="0 0 13 12" fill="none">
