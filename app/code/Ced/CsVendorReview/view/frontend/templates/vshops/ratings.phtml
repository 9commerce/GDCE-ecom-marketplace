<?php
/**
 * @var \Magento\Framework\Escaper $escaper
 */
if ($block->isActivated()) {
    $detail_rating = $block->getRatingDetails();
    $width = $block->getVendorRating();
    $avgRating = $block->getAvgRating();
    $sellerRatingCount = $block->getSellerRatingsCount();

    $width = $block->getVendorRating();
    $url = "";
    $url = $block->getUrl('csvendorreview/rating/lists', ['id' => $block->getVendorId()]);
    $helper = $block->helper(); ?>
    <?php if (($helper->isCustomerAllowed() && $helper->checkVendorProduct())
        || $avgRating > 0 || !$helper->isCustomerAllowed()
    ): ?>
        <div class="block">
            <div class="block-title" id="avg-rating-container" title=''>
                <div id="avg-rating" class="block-content vendor-rating">
                    <dl id="narrow-by-list2">
                        <ul class="rating-listing">
                            <li>
                                <span><?= $escaper->escapeHtml(__("Average Rating")) ?></span>
                                <div class="rating-summary">
                                    <div title="<?= $escaper->escapeHtml($width) ?>%" class="rating-result">
                                        <span style="width:<?= $escaper->escapeHtml($width) ?>%">
                                            <span><?= $escaper->escapeHtml($width) ?>%</span>
                                        </span>
                                    </div>
                                </div>
                            </li>
                            <?php if($detail_rating){
                                 foreach ($detail_rating as $key => $dr) {?>
                                    <li>
                                        <span><?= $escaper->escapeHtml($key) ?></span>
                                        <div class="rating-summary">
                                            <div title="<?= $dr["count"] ? $escaper->escapeHtml(ceil($dr["rating"]/$dr["count"])) : 0 ?>%"
                                                class="rating-result">
                                                    <span style="width:
                                                    <?= $dr["count"] ? $escaper->escapeHtml(ceil($dr["rating"]/$dr["count"])) : 0 ?>%">
                                                        <span>

                                                        </span>
                                                    </span>
                                            </div>
                                        </div>
                                    </li>
                                <?php }
                            } ?>
                        </ul>
                    </dl>
                </div>
                <strong><span><?= $avgRating ?></span></strong>
                <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="13"
                     height="12" viewBox="0 0 13 12" fill="none">
                    <rect x="0.445801" width="12" height="12" fill="url(#pattern0)"/>
                    <defs>
                        <pattern id="pattern0" patternContentUnits="objectBoundingBox" width="1" height="1">
                            <use xlink:href="#image0_130_227" transform="scale(0.0416667)"/>
                        </pattern>
                        <image id="image0_130_227" width="24" height="24"
                               xlink:href="data:image/png;base64,"/>
                    </defs>
                </svg>
                <?php if(!$block->isCustomerReviewPage()) { ?>
                    <span class="vendor-rating-title"><?= "(" . $sellerRatingCount . ")" . " ". __('Reviews') ?></span>
                <?php } ?>
            </div>
            <?php if(!$block->isCustomerReviewPage()) { ?>
            <div class="block-content vendor-rating">
                <div class="add_read">
                    <?php if ($sellerRatingCount > 0) { ?>
                        <a href="<?= $escaper->escapeHtml($url) ?>">
                            <?= $escaper->escapeHtml(__('Read / Add Review')) ?>
                        </a>
                    <?php } else { ?>
                        <div class="first_rate">
                            <a href="<?= $escaper->escapeHtml($url) ?>">
                                <?= $escaper->escapeHtml(__('Be The First To Review')) ?>
                            </a>
                        </div>
                    <?php } ?>
                </div>
            </div>
            <?php } ?>
        </div>
    <?php endif; ?>
    <?php
} ?>
